<Window x:Class="ChurchProjector.Views.Main.ImageWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:ChurchProjector.Views.Main"
        mc:Ignorable="d"
        Background="Black"
        Topmost="{Binding Settings.Settings.OutputDisplaySettings.TopMost}"
        WindowStartupLocation="Manual"
        x:Name="Root"
        WindowState="{Binding Settings.WindowState}"
        CanResize="False"
		ExtendClientAreaToDecorationsHint="True"
		SystemDecorations="None"
		x:DataType="local:ImageViewModel"
		ShowInTaskbar="False">

	<Grid RowDefinitions="*,Auto" ColumnDefinitions="*,Auto">
		<Image
            Name="ImageView"
            Grid.Row="0"
            Grid.ColumnSpan="2"
            IsVisible="{Binding ShowImage}"
            Source="{Binding ImageSource}"
			Opacity="{Binding Opacity}" />

		<StackPanel
            Grid.Row="1"
            Grid.Column="0"
			Orientation="Horizontal"
			IsVisible="{Binding ShowBottomBar}">
			<!-- The padding of the clock should be the same as in the banner -->
			<TextBlock
				Text="{Binding ClockText}"
				IsVisible="{Binding IsClockVisible}"
				FontSize="{Binding TextSize}"
				Foreground="White"
				VerticalAlignment="Bottom"
				Padding="10"
				Background="Black"
				ZIndex="1" />
			<StackPanel
				Name="SpBanner"
				Orientation="Horizontal"
				IsVisible="{Binding IsBannerVisible}" />
		</StackPanel>

		<TextBlock
			Grid.Row="1"
			Grid.Column="1"
			Text="{Binding CountdownText}"
			IsVisible="{Binding IsCountdownVisible}"
			FontSize="{Binding TextSize}"
			FontWeight="SemiBold"
			Foreground="{Binding CountdownForeground}"
			HorizontalAlignment="Right"
			VerticalAlignment="Bottom"
			Padding="10"
			Background="Black"
			ZIndex="2" />
	</Grid>
</Window>
