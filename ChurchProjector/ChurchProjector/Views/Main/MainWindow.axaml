<Window x:Class="ChurchProjector.Views.Main.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:local="using:ChurchProjector.Views.Main"
    xmlns:schedule="clr-namespace:ChurchProjector.Views.Schedule"
    xmlns:history="clr-namespace:ChurchProjector.Views.History"
    xmlns:bibleview="clr-namespace:ChurchProjector.Views.Bible"
	xmlns:lang="clr-namespace:ChurchProjector.Lang"
	xmlns:converters="clr-namespace:ChurchProjector.Converters"
	mc:Ignorable="d"
    WindowStartupLocation="CenterScreen"
    Title="Gottesdienst Projektor" Height="675" Width="1650"
    Icon="/Assets/icon.ico"
    x:DataType="local:MainViewModel">
    
    <Window.Resources>
        <converters:NotificationTypeConverter x:Key="NotificationTypeConverter" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Border.toolbar">
            <Setter Property="Background" Value="#0D808080" />
            <Setter Property="BorderBrush" Value="#30808080" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,10,2,2" />
        </Style>
        <Style Selector="Button.toolbar">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="36" />
        </Style>
        <Style Selector="ToggleButton.toolbar">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="36" />
        </Style>
        <Style Selector="Button.toolbar PathIcon, ToggleButton.toolbar PathIcon">
            <Setter Property="Width" Value="17" />
            <Setter Property="Height" Value="17" />
        </Style>
        <Style Selector="Border.surface">
            <Setter Property="Background" Value="#09808080" />
            <Setter Property="BorderBrush" Value="#28808080" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="GridSplitter.workspaceSplitter">
            <Setter Property="Background" Value="#40808080" />
        </Style>
        <Style Selector="ListBox.slideList > ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ListBox.slideList > ListBoxItem Border.slideCard">
            <Setter Property="Background" Value="#07808080" />
            <Setter Property="BorderBrush" Value="#38808080" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ListBox.slideList > ListBoxItem:pointerover Border.slideCard">
            <Setter Property="Background" Value="#14808080" />
            <Setter Property="BorderBrush" Value="#70808080" />
        </Style>
        <Style Selector="ListBox.slideList > ListBoxItem:selected Border.slideCard">
            <Setter Property="Background" Value="#20135BF9" />
            <Setter Property="BorderBrush" Value="#80135BF9" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </Window.Styles>

    <Panel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="280" MinHeight="280" MaxHeight="500" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" MinWidth="350" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="6" Margin="10,10,4,10" Padding="6" Classes="surface">
                <TabControl>
                    <TabItem Header="{x:Static lang:Resources.History}">
                        <history:HistoryView DataContext="{Binding HistoryViewModel}" Margin="4,8,4,4" />
                    </TabItem>
                    <TabItem Header="{x:Static lang:Resources.Schedule}">
                        <schedule:ScheduleView DataContext="{Binding ScheduleViewModel}" Margin="4,8,4,4" />
                    </TabItem>
                </TabControl>
            </Border>

            <GridSplitter Grid.Row="0" Grid.Column="1" Grid.RowSpan="6" Width="6" Margin="0,10" Classes="workspaceSplitter" ResizeDirection="Columns" />

            <Border Grid.Row="0" Grid.Column="2" Margin="10" Classes="toolbar">
                <WrapPanel Orientation="Horizontal">
                    <Button Classes="toolbar" Command="{Binding OpenSongQuickSearchCommand}" HotKey="Ctrl+Q" ToolTip.Tip="Shortcut: STRG + Q">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource QuickSearchIcon}" />
                            <TextBlock Text="{x:Static lang:Resources.SongQuickSearch}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="toolbar" Command="{Binding OpenSongSearchCommand}" HotKey="Ctrl+S" ToolTip.Tip="Shortcut: STRG + S">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource SongSearchIcon}" />
                            <TextBlock Text="{x:Static lang:Resources.SongSearch}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="toolbar" Command="{Binding OpenBibleSearchCommand}" HotKey="Ctrl+F" ToolTip.Tip="Shortcut: STRG + F">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource BibleSearchIcon}" />
                            <TextBlock Text="{x:Static lang:Resources.BibleSearch}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="toolbar" Command="{Binding AddSongCommand}" HotKey="Ctrl+N" ToolTip.Tip="Shortcut: STRG + N">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource AddIcon}" />
                            <TextBlock Text="{x:Static lang:Resources.NewSong}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="toolbar" Command="{Binding EditCommand}" IsEnabled="{Binding MayEdit}" HotKey="Ctrl+E" ToolTip.Tip="Shortcut: STRG + E">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource EditIcon}" />
                            <TextBlock Text="{x:Static lang:Resources.Edit}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="toolbar" Command="{Binding HideImageCommand}" IsEnabled="{Binding SlideSelected}" HotKey="B" ToolTip.Tip="Shortcut: B">
                        <Button.CommandParameter>
                            <system:Boolean>false</system:Boolean>
                        </Button.CommandParameter>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource HideIcon}" />
                            <TextBlock Text="{x:Static lang:Resources.InstantHide}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="toolbar" Command="{Binding HideImageCommand}" IsEnabled="{Binding ImageSelected}" HotKey="F" ToolTip.Tip="Shortcut: F">
                        <Button.CommandParameter>
                            <system:Boolean>true</system:Boolean>
                        </Button.CommandParameter>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource FadeIcon}" />
                            <TextBlock Text="{x:Static lang:Resources.SlowHide}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <ToggleButton Classes="toolbar" Command="{Binding OpenShowNotificationCommand}" HotKey="Ctrl+M" ToolTip.Tip="Shortcut: STRG + M" IsChecked="{Binding BannerIsRunning}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource MessageIcon}" />
                            <TextBlock Text="{x:Static lang:Resources.BannerMessage}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Classes="toolbar"
                                  Command="{Binding OpenTimerCommand}"
                                  HotKey="Ctrl+T"
                                  ToolTip.Tip="Shortcut: STRG + T"
                                  IsChecked="{Binding TimerIsRunning, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource TimerIcon}" />
                            <TextBlock Text="{x:Static lang:Resources.Timer}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                </WrapPanel>
            </Border>

            <ListBox Name="LboImages"
                     Grid.Row="1"
                     Grid.Column="2"
                     ItemsSource="{Binding Images.Images}"
                     SelectedItem="{Binding SelectedImage}"
                     Background="Transparent"
                     Margin="4,0,4,6"
                     Padding="4"
                     Classes="slideList">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="slideCard" Padding="8">
                            <Grid RowDefinitions="auto,*" ColumnDefinitions="*,auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="2,0,8,7"/>
                                <Svg Grid.Row="0" Grid.Column="1" Width="16" Height="16" IsVisible="{Binding IsOverflowing}" Path="/Assets/error.svg" ToolTip.Tip="Der Text überschreitet die Höhe." />
                                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" CornerRadius="5" ClipToBounds="True" Background="Black">
                                    <Image MaxWidth="250" MaxHeight="250" Source="{Binding Image}" RenderOptions.BitmapInterpolationMode="HighQuality" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Row="2" Grid.Column="2" Height="6" Margin="10,0" Classes="workspaceSplitter" ResizeDirection="Rows" />
            <Border Grid.Row="3" Grid.Column="2" Margin="10,6,10,8" Padding="10" Classes="surface">
                <bibleview:BibleView Name="BibleView" DataContext="{Binding BibleViewModel}" />
            </Border>

            <Border Grid.Row="4" Grid.Column="2" Grid.RowSpan="2" Margin="10,0,10,10" Padding="8" Classes="surface">
                <Grid ColumnDefinitions="*,auto">
                    <Border Grid.Column="0"
                               IsVisible="{Binding MayUpdate}"
                               Background="#18D08700"
                               BorderBrush="#60D08700"
                               BorderThickness="1"
                               CornerRadius="6"
                               Margin="0,0,8,0"
                               Padding="10,6">
                        <Grid ColumnDefinitions="*,auto">
                            <TextBlock
                                Grid.Column="0"
                                Foreground="#D08700"
                                Text="{Binding UpdateText}"
                                VerticalAlignment="Center" />
                            <Button
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Padding="10,4"
                                Click="OnBtnUpdateDetailsClick"
                                Content="{x:Static lang:Resources.UpdateDetails}" />
                        </Grid>
                    </Border>
                    <Button Grid.Column="1"
                            Padding="12,7"
                            Click="OnBtnSettingsClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource SettingsIcon}" Width="17" Height="17" />
                            <TextBlock Text="{x:Static lang:Resources.Settings}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    
        <ItemsControl ItemsSource="{Binding Notifications.Notifications}"
                      HorizontalAlignment="Left" VerticalAlignment="Bottom"
                      Margin="16" MaxWidth="480">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="8" Padding="12,8" Margin="0,0,0,8" BorderThickness="1"
                            Classes="notification"
                            Classes.info="{Binding Type, Converter={StaticResource NotificationTypeConverter}, ConverterParameter=Info}"
                            Classes.warning="{Binding Type, Converter={StaticResource NotificationTypeConverter}, ConverterParameter=Warning}"
                            Classes.error="{Binding Type, Converter={StaticResource NotificationTypeConverter}, ConverterParameter=Error}"
                            Classes.success="{Binding Type, Converter={StaticResource NotificationTypeConverter}, ConverterParameter=Success}"
                            MinWidth="320"
                            PointerEntered="OnNotificationEnter"
                            PointerExited="OnNotificationExit">
                        <Grid RowDefinitions="*,Auto" ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Row="0" Grid.Column="1" Content="×" FontSize="18" Padding="5,0" Margin="8,0,0,0" Click="BtnNotificationClose_OnClick"/>
                            
                            <ProgressBar Grid.Row="1"
                                         Grid.Column="0"
                                         Grid.ColumnSpan="2"
                                         Height="4"
                                         Margin="0,8,0,0"
                                         Minimum="0"
                                         Maximum="1"
                                         Value="{Binding Progress}"
                                         IsVisible="{Binding IsRunning}">
                                <ProgressBar.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Value" Duration="0:0:0.1"/>
                                    </Transitions>
                                </ProgressBar.Transitions>
                            </ProgressBar>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Panel>
</Window>
