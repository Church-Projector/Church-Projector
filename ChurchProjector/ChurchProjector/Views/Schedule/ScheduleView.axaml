<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:ChurchProjector.Views.Schedule"
             xmlns:converters="clr-namespace:ChurchProjector.Converters"
             xmlns:lang="clr-namespace:ChurchProjector.Lang"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ChurchProjector.Views.Schedule.ScheduleView"
			 x:DataType="local:ScheduleViewModel"
			 Name="Root">

	<UserControl.Resources>
		<converters:InverseBooleanConverter x:Key="InverseBool" />
		<converters:FileTypeIconConverter x:Key="FileTypeIconConverter" />
	</UserControl.Resources>

	<UserControl.Styles>
		<Style Selector="ListBox.scheduleList > ListBoxItem">
			<Setter Property="Padding" Value="0" />
			<Setter Property="Margin" Value="0,0,0,6" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="ListBox.scheduleList > ListBoxItem:selected">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="Border.scheduleEntry">
			<Setter Property="Background" Value="#07808080" />
			<Setter Property="BorderBrush" Value="#28808080" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="Padding" Value="5" />
		</Style>
		<Style Selector="ListBox.scheduleList > ListBoxItem:pointerover Border.scheduleEntry">
			<Setter Property="Background" Value="#14808080" />
			<Setter Property="BorderBrush" Value="#58808080" />
		</Style>
		<Style Selector="Button.scheduleOpen">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="7,6" />
			<Setter Property="HorizontalContentAlignment" Value="Left" />
		</Style>
		<Style Selector="Button.scheduleRemove">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="7" />
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="auto,*" RowSpacing="8">
		<Button Grid.Row="0" Command="{Binding AddScheduleEntryCommand}" HorizontalAlignment="Stretch" Padding="10,7">
			<StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
				<PathIcon Data="{StaticResource AddIcon}" Width="16" Height="16" />
				<TextBlock Text="{x:Static lang:Resources.AddFile}" VerticalAlignment="Center" />
			</StackPanel>
		</Button>

		<ListBox Name="LboSchedules" Grid.Row="1" ItemsSource="{Binding Schedules}" Background="Transparent" Classes="scheduleList" SelectionChanged="LboSchedules_SelectionChanged">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<Border Classes="scheduleEntry">
						<Grid ColumnDefinitions="auto,auto,auto,*,auto,auto">
							<PathIcon Grid.Column="0" Width="16" Height="16" Margin="3" Foreground="{DynamicResource ErrorBackground}" IsVisible="{Binding FileExists, Converter={StaticResource InverseBool}}" Data="{StaticResource ErrorIcon}" ToolTip.Tip="{x:Static lang:Resources.FileNotFound}" />
							<PathIcon Grid.Column="1" Width="16" Height="16" Margin="3" Foreground="{DynamicResource ErrorBackground}" IsVisible="{Binding ApplicationExists, Converter={StaticResource InverseBool}}" Data="{StaticResource ErrorIcon}" ToolTip.Tip="{x:Static lang:Resources.ProgramNotFound}" />
							<PathIcon Grid.Column="2" Width="22" Height="22" Margin="3" IsVisible="{Binding HasIcon}" Data="{Binding IconType, Converter={StaticResource FileTypeIconConverter}}" />
							<Button Grid.Column="3" Classes="scheduleOpen" Command="{Binding ((local:ScheduleViewModel)DataContext).OpenScheduleEntryCommand, ElementName=Root}" CommandParameter="{Binding .}" HorizontalAlignment="Stretch">
								<TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
							</Button>
							<Button Grid.Column="4" Classes="scheduleRemove" Command="{Binding ((local:ScheduleViewModel)DataContext).RemoveScheduleEntryCommand, ElementName=Root}" CommandParameter="{Binding .}" ToolTip.Tip="Entfernen">
								<PathIcon Data="{StaticResource RemoveIcon}" Width="14" Height="14" />
							</Button>
							<PathIcon Grid.Column="5" Width="20" Height="20" Margin="5" Opacity="0.65" Data="{StaticResource DragIndicatorIcon}" PointerPressed="DragHandle_PointerPressed" ToolTip.Tip="{x:Static lang:Resources.Move}" />

							<Grid.ContextMenu>
								<ContextMenu>
									<MenuItem Command="{Binding ((local:ScheduleViewModel)DataContext).CopyFilePathCommand, ElementName=Root}" CommandParameter="{Binding .}" Header="{x:Static lang:Resources.CopyFilePath}" />
									<MenuItem Command="{Binding ((local:ScheduleViewModel)DataContext).OpenFilePathCommand, ElementName=Root}" CommandParameter="{Binding .}" Header="{x:Static lang:Resources.OpenFilePath}" />
									<MenuItem Command="{Binding ((local:ScheduleViewModel)DataContext).DeleteFilePathCommand, ElementName=Root}" CommandParameter="{Binding .}" Header="{x:Static lang:Resources.DeleteFile}" />
								</ContextMenu>
							</Grid.ContextMenu>
						</Grid>
					</Border>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
	</Grid>
</UserControl>
