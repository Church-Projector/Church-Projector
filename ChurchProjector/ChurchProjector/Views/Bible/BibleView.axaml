<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:local="clr-namespace:ChurchProjector.Views.Bible"
			 xmlns:converters="clr-namespace:ChurchProjector.Converters"
			 xmlns:lang="clr-namespace:ChurchProjector.Lang"
             mc:Ignorable="d" d:DesignWidth="800" MinHeight="250"
             x:Class="ChurchProjector.Views.Bible.BibleView"
			 x:DataType="local:BibleViewModel">

	<UserControl.Resources>
		<converters:StringIsNotEmptyConverter x:Key="StringIsNotEmptyConverter" />
		<StreamGeometry x:Key="SearchIcon">M9.5 3C5.91 3 3 5.91 3 9.5S5.91 16 9.5 16C11.11 16 12.58 15.41 13.72 14.44L19.28 20L20.7 18.58L15.14 13.02C15.68 12.01 16 10.8 16 9.5C16 5.91 13.09 3 9.5 3M9.5 5C11.99 5 14 7.01 14 9.5S11.99 14 9.5 14S5 11.99 5 9.5S7.01 5 9.5 5Z</StreamGeometry>
		<StreamGeometry x:Key="BackIcon">M20 11H7.83L13.42 5.41L12 4L4 12L12 20L13.42 18.59L7.83 13H20V11Z</StreamGeometry>
		<StreamGeometry x:Key="NextIcon">M4 11H16.17L10.58 5.41L12 4L20 12L12 20L10.58 18.59L16.17 13H4V11Z</StreamGeometry>
	</UserControl.Resources>

	<UserControl.Styles>
		<Style Selector="GridSplitter.bibleSplitter">
			<Setter Property="Background" Value="#40808080" />
		</Style>
		<Style Selector="ListBox.versePreview">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="ListBox.versePreview > ListBoxItem">
			<Setter Property="Padding" Value="0" />
			<Setter Property="Margin" Value="0,0,0,6" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="Border.verseCard">
			<Setter Property="Padding" Value="9" />
			<Setter Property="Background" Value="#07808080" />
			<Setter Property="BorderBrush" Value="#28808080" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="6" />
		</Style>
		<Style Selector="ListBox.versePreview > ListBoxItem:pointerover Border.verseCard">
			<Setter Property="Background" Value="#14808080" />
			<Setter Property="BorderBrush" Value="#58808080" />
		</Style>
		<Style Selector="ListBox.versePreview > ListBoxItem:selected Border.verseCard">
			<Setter Property="Background" Value="#20135BF9" />
			<Setter Property="BorderBrush" Value="#80135BF9" />
		</Style>
		<Style Selector="Border.verseNumber">
			<Setter Property="Background" Value="#18808080" />
			<Setter Property="CornerRadius" Value="10" />
			<Setter Property="MinWidth" Value="28" />
			<Setter Property="Padding" Value="6,2" />
		</Style>
	</UserControl.Styles>

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="auto" MinWidth="300" />
			<ColumnDefinition Width="auto" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<TabControl Margin="0,0,2,0">
			<TabItem>
				<TabItem.Header>
					<TextBlock Text="{x:Static lang:Resources.Search}" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Window}}" />
				</TabItem.Header>
				<Grid ColumnDefinitions="*,auto" RowDefinitions="auto,auto,auto,*,auto" RowSpacing="6" Margin="4">
					<TextBox Grid.Row="0" Grid.Column="0" MinHeight="36" Text="{Binding SearchText}" KeyDown="TextBox_KeyDown" Classes="clearButton" />
					<Button Grid.Row="0" Grid.Column="1" Margin="6,0,0,0" Padding="12,6" Command="{Binding AcceptSearchTextCommand}" IsEnabled="{Binding MayAcceptSearchTextCommand}">
						<StackPanel Orientation="Horizontal" Spacing="6">
							<PathIcon Data="{StaticResource SearchIcon}" Width="16" Height="16" />
							<TextBlock Text="{x:Static lang:Resources.Ok}" VerticalAlignment="Center" />
						</StackPanel>
					</Button>

					<TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="2,0" Opacity="0.72" Text="{Binding BibleSearchHintPreview}" />
					<TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="2,0" Text="{Binding Error}" Foreground="#E9003E" TextTrimming="CharacterEllipsis" />

					<StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6">
						<Button IsEnabled="{Binding CanGoBack}" Command="{Binding BackVerseCommand}" Padding="10,6">
							<StackPanel Orientation="Horizontal" Spacing="5">
								<PathIcon Data="{StaticResource BackIcon}" Width="15" Height="15" />
								<TextBlock Text="{x:Static lang:Resources.Back}" VerticalAlignment="Center" />
							</StackPanel>
						</Button>
						<Button IsEnabled="{Binding CanGoNext}" Command="{Binding NextVerseCommand}" Padding="10,6">
							<StackPanel Orientation="Horizontal" Spacing="5">
								<TextBlock Text="{x:Static lang:Resources.Next}" VerticalAlignment="Center" />
								<PathIcon Data="{StaticResource NextIcon}" Width="15" Height="15" />
							</StackPanel>
						</Button>
					</StackPanel>
				</Grid>
			</TabItem>

			<TabItem>
				<TabItem.Header>
					<TextBlock Text="{x:Static lang:Resources.Selection}" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Window}}" />
				</TabItem.Header>

				<Grid ColumnDefinitions="*,auto" RowDefinitions="auto,*" Margin="4">
					<TextBlock Grid.Column="0" Grid.Row="0" Text="{x:Static lang:Resources.Book_Colon}" FontWeight="SemiBold" Margin="4,0,0,6" />
					<ListBox Grid.Column="0" Grid.Row="1" ItemsSource="{Binding SelectedBible1.Books}" SelectedItem="{Binding SelectedBook}">
						<ListBox.ItemTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding Title}" />
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>

					<TextBlock Grid.Column="1" Grid.Row="0" Text="{x:Static lang:Resources.Chapter_Colon}" FontWeight="SemiBold" Margin="12,0,0,6" />
					<ListBox Grid.Column="1" Grid.Row="1" Margin="10 0 0 0" MinWidth="100" ItemsSource="{Binding SelectedBook.Chapters}" SelectedItem="{Binding SelectedChapter}" />
				</Grid>
			</TabItem>

			<TabItem>
				<TabItem.Header>
					<TextBlock Text="{x:Static lang:Resources.Translation}" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Window}}" />
				</TabItem.Header>
				<StackPanel Spacing="8" Margin="4">
					<TextBlock Text="{x:Static lang:Resources.Translation_First}" FontWeight="SemiBold" />
					<ComboBox ItemsSource="{Binding Bibles}" SelectedItem="{Binding SelectedBible1}" MinWidth="250" HorizontalAlignment="Stretch">
						<ComboBox.ItemTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding Title}" />
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>

					<TextBlock Text="{x:Static lang:Resources.Translation_Second}" FontWeight="SemiBold" Margin="0,4,0,0" />
					<ComboBox ItemsSource="{Binding Bibles}" SelectedItem="{Binding SelectedBible2}" MinWidth="250" HorizontalAlignment="Stretch">
						<ComboBox.ItemTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding Title}" />
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>

					<TextBlock Text="{x:Static lang:Resources.Translation_Third}" FontWeight="SemiBold" Margin="0,4,0,0" />
					<ComboBox ItemsSource="{Binding Bibles}" SelectedItem="{Binding SelectedBible3}" MinWidth="250" HorizontalAlignment="Stretch">
						<ComboBox.ItemTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding Title}" />
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
				</StackPanel>
			</TabItem>
		</TabControl>
		<GridSplitter Grid.Column="1" Width="6" Classes="bibleSplitter" ResizeDirection="Columns" Margin="10,0" />

		<ListBox x:Name="ListBox" Grid.Column="2" ItemsSource="{Binding PreviewSelectedBiblePosition}" Height="{Binding $parent.Bounds.Height}" PointerReleased="ListBox_PointerReleased" SelectionMode="Multiple" Classes="versePreview">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<Border Classes="verseCard">
						<Grid ColumnDefinitions="auto,*" ColumnSpacing="9">
							<Border Grid.Column="0" Classes="verseNumber" VerticalAlignment="Top">
								<TextBlock Text="{Binding Key}" FontWeight="SemiBold" HorizontalAlignment="Center" />
							</Border>
							<TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" LineHeight="21" />
						</Grid>
					</Border>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
	</Grid>
</UserControl>
